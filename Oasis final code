              if (!confirm('Are you sure you want to delete this project?')) return;
              
              const projectIndex = projectData.findIndex(p => p.id === projectId);
              if (projectIndex === -1) return;
              
              const project = projectData[projectIndex];
              
              // Remove from data
              projectData.splice(projectIndex, 1);
              
              // Delete associated tasks
              taskData = taskData.filter(task => task.project !== projectId);
              
              // Update UI
              renderProjects();
              updateProjectSelector();
              
              // If this was the current project, go back to projects list
              if (currentProject && currentProject.id === projectId) {
                currentProject = null;
                navigateTo('projects');
              }
              
              // Show success message
              showToast('success', 'Project Deleted', 'Project has been deleted successfully');
              
