     * @param {string} description - Activity description
     */
    function logActivity(type, description) {
        const activity = {
            id: 'activity-' + Date.now(),
            type,
            description,
            user: currentUser.name,
            userId: currentUser.id,
            timestamp: new Date()
        };
        
        // Add to activity data
        activityData.unshift(activity);
        
        // Limit to last 100 activities
        if (activityData.length > 100) {
            activityData = activityData.slice(0, 100);
        }
        
        // Save to localStorage
        localStorage.setItem('activityData', JSON.stringify(activityData));
        
        // Update activity timeline if visible
        if (document.querySelector('.activity-timeline')) {
            initializeActivityTimeline();
        }
