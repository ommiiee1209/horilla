    /**
     * Set up kanban drag and drop
     */
    function setupKanbanDragDrop() {
        const kanbanColumns = document.querySelectorAll('.kanban-column-content');
        let draggedTask = null;
        
        // Make columns drop targets
        kanbanColumns.forEach(column => {
            column.addEventListener('dragover', (e) => {
                e.preventDefault();
                const dragging = document.querySelector('.dragging');
                if (dragging) {
                    column.appendChild(dragging);
                }
            });
            
            column.addEventListener('drop', (e) => {
                e.preventDefault();
                const taskId = e.dataTransfer.getData('text/plain');
                const taskElement = document.querySelector(`.kanban-card[data-task-id="${taskId}"]`);
                
                if (taskElement) {
                    // Get new status from parent column
                    const newStatus = column.closest('.kanban-column').getAttribute('data-status');
                    
                    // Update task data
                    const taskIndex = taskData.findIndex(t => t.id === taskId);
                    if (taskIndex !== -1) {
                        taskData[taskIndex].status = newStatus;
                        taskData[taskIndex].updatedAt = new Date();
                        
                        // Update list view
                        updateTaskUI(taskData[taskIndex]);
                        
                        // Log activity
                        logActivity('task_updated', `Updated task status to ${getStatusText(newStatus)}: ${taskData[taskIndex].title}`);
                    }
                }
            });
        });
    }
    
    /**
