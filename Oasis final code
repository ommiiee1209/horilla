//HTML CODE named as (z-index.html)


<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OASiS - プロジェクト管理ツール</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Language Switcher -->
    <div class="language-switcher">
        <div class="language-option" data-lang="ja">日本語</div>
        <div class="language-option" data-lang="en">English</div>
    </div>

    <!-- Authentication Section -->
    <div class="auth-container">
        <!-- Login Form -->
        <div class="auth-form" id="login-form">
            <div class="auth-header">
                <h1>OASiS</h1>
                <h2 data-i18n="login.title">ログイン</h2>
            </div>
            <div class="form-group">
                <input type="text" id="login-email" placeholder=" " data-i18n-placeholder="login.email">
                <label for="login-email" data-i18n="login.email"></label>
            </div>
            <div class="form-group">
                <input type="password" id="login-password" placeholder=" " data-i18n-placeholder="login.password">
                <label for="login-password" data-i18n="login.password"></label>
            </div>
            <div class="form-options">
                <div class="remember-me">
                    <input type="checkbox" id="remember-me">
                    <label for="remember-me" data-i18n="login.remember">ログイン状態を保存</label>
                </div>
                <a href="#" class="forgot-password" data-i18n="login.forgot">パスワードをお忘れですか？</a>
            </div>
            <button class="btn-primary" id="btn-login" data-i18n="login.button">ログイン</button>
            <div class="auth-divider" data-i18n="login.or">または</div>
            <div class="social-login">
                <button class="social-btn google-btn">
                    <img src="images/google-icon.svg" alt="Google">
                </button>
                <button class="social-btn facebook-btn">
                    <img src="images/facebook-icon.svg" alt="Facebook">
                </button>
                <button class="social-btn twitter-btn">
                    <img src="images/twitter-icon.svg" alt="Twitter">
                </button>
            </div>
            <div class="auth-footer">
                <span data-i18n="login.signup.prompt">アカウントをお持ちでないですか？</span> 
                <a href="#" id="link-signup" data-i18n="login.signup.link">サインアップ</a>
            </div>
        </div>

        <!-- Registration Form -->
        <div class="auth-form" id="signup-form">
            <div class="auth-header">
                <h1>OASiS</h1>
                <h2 data-i18n="signup.title">新規登録</h2>
            </div>
            <div class="form-group">
                <input type="text" id="signup-name" placeholder=" " data-i18n-placeholder="signup.name">
                <label for="signup-name" data-i18n="signup.name"></label>
            </div>
            <div class="form-group">
                <input type="email" id="signup-email" placeholder=" " data-i18n-placeholder="signup.email">
                <label for="signup-email" data-i18n="signup.email"></label>
            </div>
            <div class="form-group">
                <input type="password" id="signup-password" placeholder=" " data-i18n-placeholder="signup.password">
                <label for="signup-password" data-i18n="signup.password"></label>
            </div>
            <div class="form-group">
                <input type="password" id="signup-confirm-password" placeholder=" " data-i18n-placeholder="signup.confirm">
                <label for="signup-confirm-password" data-i18n="signup.confirm"></label>
            </div>
            <button class="btn-primary" id="btn-signup" data-i18n="signup.button">登録</button>
            <div class="auth-divider" data-i18n="signup.or">または</div>
            <div class="social-login">
                <button class="social-btn google-btn">
                    <img src="images/google-icon.svg" alt="Google">
                </button>
                <button class="social-btn facebook-btn">
                    <img src="images/facebook-icon.svg" alt="Facebook">
                </button>
                <button class="social-btn twitter-btn">
                    <img src="images/twitter-icon.svg" alt="Twitter">
                </button>
            </div>
            <div class="auth-footer">
                <span data-i18n="signup.login.prompt">すでにアカウントをお持ちですか？</span> 
                <a href="#" id="link-login" data-i18n="signup.login.link">ログイン</a>
            </div>
        </div>

        <!-- Password Reset Form -->
        <div class="auth-form" id="reset-password-form">
            <div class="auth-header">
                <h1>OASiS</h1>
                <h2 data-i18n="reset.title">パスワードをリセット</h2>
                <p data-i18n="reset.instructions">登録したメールアドレスを入力してください。パスワードリセット用のコードを送信します。</p>
            </div>
            <div class="reset-step" id="reset-step-1">
                <div class="form-group">
                    <input type="email" id="reset-email" placeholder=" " data-i18n-placeholder="reset.email">
                    <label for="reset-email" data-i18n="reset.email"></label>
                </div>
                <button class="btn-primary" id="btn-send-code" data-i18n="reset.send">コードを送信</button>
            </div>
            <div class="reset-step" id="reset-step-2">
                <p data-i18n="reset.code.instructions">メールに送信された6桁のコードを入力してください</p>
                <div class="verification-code">
                    <input type="text" maxlength="1">
                    <input type="text" maxlength="1">
                    <input type="text" maxlength="1">
                    <input type="text" maxlength="1">
                    <input type="text" maxlength="1">
                    <input type="text" maxlength="1">
                </div>
                <div class="resend-code">
                    <span data-i18n="reset.code.resend">コードが届かない場合は</span> 
                    <a href="#" id="link-resend" data-i18n="reset.code.resend.link">再送信</a>
                    <span id="timer">(60秒)</span>
                </div>
                <button class="btn-primary" id="btn-verify-code" data-i18n="reset.code.verify">確認</button>
            </div>
            <div class="reset-step" id="reset-step-3">
                <p data-i18n="reset.password.instructions">新しいパスワードを設定してください</p>
                <div class="form-group">
                    <input type="password" id="new-password" placeholder=" " data-i18n-placeholder="reset.password.new">
                    <label for="new-password" data-i18n="reset.password.new"></label>
                </div>
                <div class="form-group">
                    <input type="password" id="confirm-new-password" placeholder=" " data-i18n-placeholder="reset.password.confirm">
                    <label for="confirm-new-password" data-i18n="reset.password.confirm"></label>
                </div>
                <button class="btn-primary" id="btn-reset-password" data-i18n="reset.password.button">パスワードをリセット</button>
            </div>
            <a href="#" id="link-back-to-login" data-i18n="reset.back.login">ログインに戻る</a>
        </div>
    </div>

    <!-- Main Application -->
    <div class="app-container">
        <!-- Header -->
        <header class="app-header">
            <button class="sidebar-toggle" id="sidebar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <h1 data-i18n="app.title">プロジェクト管理ツール</h1>
            <div class="header-controls">
                <div class="user-profile">
                    <img src="images/profile-placeholder.jpg" alt="User Profile" class="profile-image">
                    <span class="username">User Name</span>
                    <div class="dropdown-menu">
                        <ul>
                            <li><a href="#" id="profile-link">プロフィール</a></li>
                            <li><a href="#" id="settings-link">設定</a></li>
                            <li><a href="#" id="logout-link">ログアウト</a></li>
                        </ul>
                    </div>
                </div>
                <button class="notifications-btn">
                    <span class="notification-icon">🔔</span>
                    <span class="notification-count">3</span>
                </button>
            </div>
        </header>

        <!-- Sidebar Navigation -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h2>OASiS</h2>
            </div>
            <ul class="sidebar-menu">
                <li class="active" data-page="dashboard" data-i18n="sidebar.dashboard">ダッシュボード</li>
                <li data-page="projects" data-i18n="sidebar.projects">プロジェクト</li>
                <li data-page="tasks" data-i18n="sidebar.tasks">タスク</li>
                <li data-page="reports" data-i18n="sidebar.reports">レポート</li>
                <li data-page="members" data-i18n="sidebar.members">メンバー</li>
                <li data-page="bulletin" data-i18n="sidebar.bulletin">掲示板</li>
            </ul>
        </nav>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Dashboard Page -->
            <section class="page" id="dashboard-page">
                <h2 data-i18n="dashboard.title">ダッシュボード</h2>
                
                <div class="quick-actions">
                    <div class="selector-group">
                        <label data-i18n="dashboard.select.project">プロジェクトを選択:</label>
                        <select id="project-selector">
                            <option>プロジェクトA</option>
                            <option>プロジェクトB</option>
                            <option>プロジェクトC</option>
                        </select>

                        <label data-i18n="dashboard.select.task">タスクを選択:</label>
                        <select id="task-selector">
                            <option>タスク1 - 完了</option>
                            <option>タスク2 - 進行中</option>
                            <option>タスク3 - 保留</option>
                        </select>

                        <button class="btn-secondary" id="btn-view-details" data-i18n="dashboard.button.details">
                           詳細を表示
                        </button>
                    </div>
                </div>
                
                <div class="dashboard-cards">
                    <div class="card">
                        <div class="card-header">
                            <h3 data-i18n="dashboard.projects.overview">プロジェクト概要</h3>
                        </div>
                        <div class="card-content">
                            <p data-i18n="dashboard.projects.stats" data-var-total="10" data-var-active="5" data-var-completed="3">
                                合計: 10 | アクティブ: 5 | 完了: 3
                            </p>
                            <div class="chart" id="projects-chart"></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 data-i18n="dashboard.tasks.overview">タスク概要</h3>
                        </div>
                        <div class="card-content">
                            <p data-i18n="dashboard.tasks.completed" data-var-count="8">完了: 8</p>
                            <div class="progress-bar">
                                <div class="progress" style="width: 80%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 data-i18n="dashboard.bulletin.title">掲示板</h3>
                        </div>
                        <div class="card-content">
                            <div class="bulletin-preview">
                                <div class="bulletin-item">
                                    <h4>新しいプロジェクトのお知らせ</h4>
                                    <p>2023年7月15日より新プロジェクト「モバイルアプリ開発」が開始されます。</p>
                                    <span class="bulletin-date">2023/07/01</span>
                                </div>
                                <div class="bulletin-item">
                                    <h4>システムメンテナンスのお知らせ</h4>
                                    <p>2023年7月10日 午前2時〜5時までシステムメンテナンスを実施します。</p>
                                    <span class="bulletin-date">2023/07/05</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="dashboard-bottom-section">
                    <div class="recent-activities">
                        <h3>最近のアクティビティ</h3>
                        <ul class="activity-list">
                            <li class="activity-item">
                                <div class="activity-icon task-completed">✓</div>
                                <div class="activity-content">
                                    <p><strong>山田太郎</strong>がタスク「デザインレビュー」を完了しました</p>
                                    <span class="activity-time">2時間前</span>
                                </div>
                            </li>
                            <li class="activity-item">
                                <div class="activity-icon comment-added">💬</div>
                                <div class="activity-content">
                                    <p><strong>鈴木花子</strong>がタスク「API開発」にコメントしました</p>
                                    <span class="activity-time">4時間前</span>
                                </div>
                            </li>
                            <li class="activity-item">
                                <div class="activity-icon task-assigned">👤</div>
                                <div class="activity-content">
                                    <p><strong>佐藤次郎</strong>にタスク「テスト実施」が割り当てられました</p>
                                    <span class="activity-time">昨日</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                    
                    <div class="upcoming-deadlines">
                        <h3>直近の期限</h3>
                        <ul class="deadline-list">
                            <li class="deadline-item">
                                <div class="deadline-project">プロジェクトA</div>
                                <div class="deadline-task">フロントエンド実装</div>
                                <div class="deadline-date warning">今日</div>
                            </li>
                            <li class="deadline-item">
                                <div class="deadline-project">プロジェクトB</div>
                                <div class="deadline-task">データベース設計</div>
                                <div class="deadline-date">明日</div>
                            </li>
                            <li class="deadline-item">
                                <div class="deadline-project">プロジェクトC</div>
                                <div class="deadline-task">要件定義</div>
                                <div class="deadline-date">3日後</div>
                            </li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- Projects Page -->
            <section class="page" id="projects-page">
                <h2>プロジェクト</h2>
                
                <div class="page-actions">
                    <div class="search-container">
                        <input type="text" id="project-search" placeholder="プロジェクトを検索...">
                        <button class="search-btn">🔍</button>
                    </div>
                    <button class="btn-primary" id="btn-create-project">新規プロジェクト</button>
                </div>
                
                <div class="filter-options">
                    <div class="filter-group">
                        <label>ステータス:</label>
                        <select id="project-status-filter">
                            <option value="all">すべて</option>
                            <option value="active">進行中</option>
                            <option value="completed">完了</option>
                            <option value="on-hold">保留中</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>並び替え:</label>
                        <select id="project-sort">
                            <option value="date-desc">新しい順</option>
                            <option value="date-asc">古い順</option>
                            <option value="name-asc">名前 (A-Z)</option>
                            <option value="name-desc">名前 (Z-A)</option>
                        </select>
                    </div>
                </div>
                
                <div class="projects-grid">
                    <!-- Project cards will be dynamically generated here -->
                    <div class="project-card">
                        <div class="project-header">
                            <h3>ウェブサイトリニューアル</h3>
                            <div class="project-status active">進行中</div>
                        </div>
                        <div class="project-details">
                            <p>企業ウェブサイトの全面リニューアル</p>
                            <div class="project-meta">
                                <div class="project-dates">
                                    <div>開始: 2023/06/01</div>
                                    <div>終了: 2023/08/31</div>
                                </div>
                                <div class="project-progress">
                                    <div class="progress-label">65%</div>
                                    <div class="progress-bar">
                                        <div class="progress" style="width: 65%;"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="project-members">
                                <div class="member-avatars">
                                    <img src="images/avatar1.jpg" alt="Member 1">
                                    <img src="images/avatar2.jpg" alt="Member 2">
                                    <img src="images/avatar3.jpg" alt="Member 3">
                                    <span class="more-members">+2</span>
                                </div>
                            </div>
                        </div>
                        <div class="project-actions">
                            <button class="btn-view-project" data-project-id="p1">詳細を表示</button>
                            <div class="project-menu-toggle">⋮</div>
                        </div>
                    </div>
                    
                    <div class="project-card">
                        <div class="project-header">
                            <h3>モバイルアプリ開発</h3>
                            <div class="project-status active">進行中</div>
                        </div>
                        <div class="project-details">
                            <p>クロスプラットフォームモバイルアプリケーションの開発</p>
                            <div class="project-meta">
                                <div class="project-dates">
                                    <div>開始: 2023/05/15</div>
                                    <div>終了: 2023/09/30</div>
                                </div>
                                <div class="project-progress">
                                    <div class="progress-label">40%</div>
                                    <div class="progress-bar">
                                        <div class="progress" style="width: 40%;"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="project-members">
                                <div class="member-avatars">
                                    <img src="images/avatar2.jpg" alt="Member 2">
                                    <img src="images/avatar4.jpg" alt="Member 4">
                                    <img src="images/avatar5.jpg" alt="Member 5">
                                </div>
                            </div>
                        </div>
                        <div class="project-actions">
                            <button class="btn-view-project" data-project-id="p2">詳細を表示</button>
                            <div class="project-menu-toggle">⋮</div>
                        </div>
                    </div>
                </div>
                
                <!-- Project Detail Modal -->
                <div class="modal" id="project-detail-modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 id="modal-project-title">プロジェクト詳細</h2>
                            <button class="close-modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <div class="project-detail-tabs">
                                <div class="tab active" data-tab="overview">概要</div>
                                <div class="tab" data-tab="tasks">タスク</div>
                                <div class="tab" data-tab="members">メンバー</div>
                                <div class="tab" data-tab="files">ファイル</div>
                                <div class="tab" data-tab="discussion">ディスカッション</div>
                            </div>
                            
                            <div class="tab-content" id="tab-overview">
                                <!-- Project overview content -->
                            </div>
                            
                            <div class="tab-content" id="tab-tasks">
                                <!-- Project tasks content -->
                            </div>
                            
                            <div class="tab-content" id="tab-members">
                                <!-- Project members content -->
                            </div>
                            
                            <div class="tab-content" id="tab-files">
                                <!-- Project files content -->
                            </div>
                            
                            <div class="tab-content" id="tab-discussion">
                                <!-- Project discussion content -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Create Project Modal -->
                <div class="modal" id="create-project-modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2>新規プロジェクト</h2>
                            <button class="close-modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <form id="create-project-form">
                                <div class="form-group">
                                    <label for="project-name">プロジェクト名</label>
                                    <input type="text" id="project-name" required>
                                </div>
                                <div class="form-group">
                                    <label for="project-description">説明</label>
                                    <textarea id="project-description" rows="3"></textarea>
                                </div>
                                <div class="form-row">
                                    <div class="form-group half">
                                        <label for="project-start-date">開始日</label>
                                        <input type="date" id="project-start-date" required>
                                    </div>
                                    <div class="form-group half">
                                        <label for="project-end-date">終了日</label>
                                        <input type="date" id="project-end-date" required>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="project-members">メンバー</label>
                                    <select id="project-members" multiple>
                                        <option value="user1">山田太郎</option>
                                        <option value="user2">鈴木花子</option>
                                        <option value="user3">佐藤次郎</option>
                                        <option value="user4">田中美咲</option>
                                        <option value="user5">高橋健太</option>
                                    </select>
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn-secondary cancel-modal">キャンセル</button>
                                    <button type="submit" class="btn-primary">作成</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Tasks Page -->
            <section class="page" id="tasks-page">
                <h2>タスク</h2>
                
                <div class="page-actions">
                    <div class="search-container">
                        <input type="text" id="task-search" placeholder="タスクを検索...">
                        <button class="search-btn">🔍</button>
                    </div>
                    <button class="btn-primary" id="btn-create-task">新規タスク</button>
                </div>
                
                <div class="filter-options">
                    <div class="filter-group">
                        <label>プロジェクト:</label>
                        <select id="task-project-filter">
                            <option value="all">すべて</option>
                            <option value="p1">ウェブサイトリニューアル</option>
                            <option value="p2">モバイルアプリ開発</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>ステータス:</label>
                        <select id="task-status-filter">
                            <option value="all">すべて</option>
                            <option value="not-started">未着手</option>
                            <option value="in-progress">進行中</option>
                            <option value="completed">完了</option>
                            <option value="on-hold">保留中</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>担当者:</label>
                        <select id="task-assignee-filter">
                            <option value="all">すべて</option>
                            <option value="user1">山田太郎</option>
                            <option value="user2">鈴木花子</option>
                            <option value="user3">佐藤次郎</option>
                            <option value="user4">田中美咲</option>
                            <option value="user5">高橋健太</option>
                        </select>
                    </div>
                </div>
                
                <div class="task-view-options">
                    <button class="view-option active" data-view="list">リスト</button>
                    <button class="view-option" data-view="kanban">かんばん</button>
                    <button class="view-option" data-view="calendar">カレンダー</button>
                </div>
                
                <!-- List View -->
                <div class="task-view" id="list-view">
                    <table class="tasks-table">
                        <thead>
                            <tr>
                                <th>タスク名</th>
                                <th>プロジェクト</th>
                                <th>担当者</th>
                                <th>期限</th>
                                <th>ステータス</th>
                                <th>優先度</th>
                                <th>アクション</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>ワイヤーフレーム作成</td>
