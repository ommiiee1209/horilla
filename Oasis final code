    /**
     * Update task
     */
    function updateTask() {
        const taskId = document.getElementById('edit-task-id').value;
        const taskIndex = taskData.findIndex(t => t.id === taskId);
        
        if (taskIndex === -1) return;
        
        const title = document.getElementById('edit-task-title').value;
        const description = document.getElementById('edit-task-description').value;
        const project = document.getElementById('edit-task-project').value;
        const status = document.getElementById('edit-task-status').value;
        const priority = document.getElementById('edit-task-priority').value;
        const assignee = document.getElementById('edit-task-assignee').value;
        const dueDate = document.getElementById('edit-task-due-date').value;
        
        // Update task data
        taskData[taskIndex] = {
            ...taskData[taskIndex],
            title,
            description,
            project,
            status,
            priority,
            assignee,
            dueDate: dueDate ? new Date(dueDate) : null,
            updatedAt: new Date()
        };
        
        // Update UI
        updateTaskUI(taskData[taskIndex]);
        
        // Close modal
        closeModal(document.getElementById('edit-task-modal'));
        
        // Show success message
        showToast('success', 'タスク更新完了', 'タスクが正常に更新されました。');
        
