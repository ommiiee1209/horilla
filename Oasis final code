    // Update task completion trend chart (continued)
    function updateTaskCompletionTrendChart() {
        const ctx = document.getElementById('task-completion-trend-chart');
        if (!ctx) return;
        
        // Get last 7 days
        const dates = [];
        const completedCounts = [];
        const createdCounts = [];
        
        for (let i = 6; i >= 0; i--) {
            const date = new Date();
            date.setDate(date.getDate() - i);
            date.setHours(0, 0, 0, 0);
            
            const dateString = formatDate(date);
            dates.push(dateString);
            
            // Count completed tasks for this date
            const completedCount = taskData.filter(task => {
                if (!task.completedAt) return false;
                const completedDate = new Date(task.completedAt);
                completedDate.setHours(0, 0, 0, 0);
                return formatDate(completedDate) === dateString;
            }).length;
            
            // Count created tasks for this date
            const createdCount = taskData.filter(task => {
                if (!task.createdAt) return false;
                const createdDate = new Date(task.createdAt);
                createdDate.setHours(0, 0, 0, 0);
                return formatDate(createdDate) === dateString;
            }).length;
            
            completedCounts.push(completedCount);
            createdCounts.push(createdCount);
        }
        
        // Create or update chart
        if (!chartInstances.taskCompletionTrend) {
            chartInstances.taskCompletionTrend = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [
                        {
                            label: '完了したタスク',
                            data: completedCounts,
                            borderColor: '#28a745',
                            backgroundColor: 'rgba(40, 167, 69, 0.1)',
                            tension: 0.4,
                            fill: true
