    /**
     * Create kanban card element
     * @param {Object} task - Task data
     * @returns {HTMLElement} - Kanban card element
     */
    function createKanbanCard(task) {
        const card = document.createElement('div');
        card.className = 'kanban-card';
        card.setAttribute('data-task-id', task.id);
        card.setAttribute('draggable', 'true');
        
        // Find assignee and project names
        const assigneeName = document.querySelector(`#task-assignee option[value="${task.assignee}"]`)?.textContent || 'Unassigned';
        const projectName = document.querySelector(`#task-project option[value="${task.project}"]`)?.textContent || 'No Project';
        
        // Format due date
        const dueDate = task.dueDate ? formatDate(task.dueDate) : 'No due date';
        
        // Calculate days until due
        let daysUntilDue = '';
        let dueDateClass = '';
        
        if (task.dueDate) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            const due = new Date(task.dueDate);
            due.setHours(0, 0, 0, 0);
            
            const diffTime = due - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays < 0) {
                daysUntilDue = `${Math.abs(diffDays)}日遅延`;
                dueDateClass = 'overdue';
            } else if (diffDays === 0) {
                daysUntilDue = '今日期限';
                dueDateClass = 'due-today';
            } else if (diffDays === 1) {
                daysUntilDue = '明日期限';
                dueDateClass = 'due-soon';
            } else if (diffDays <= 3) {
                daysUntilDue = `${diffDays}日以内`;
                dueDateClass = 'due-soon';
            } else {
                daysUntilDue = `${diffDays}日後`;
            }
        }
        
        // Create card content
        card.innerHTML = `
            <div class="kanban-card-header">
                <div class="kanban-card-title">${task.title}</div>
                <div class="kanban-card-priority priority-${task.priority}"></div>
            </div>
            <div class="kanban-card-body">
                <div class="kanban-card-project">${projectName}</div>
                <div class="kanban-card-description">${task.description ? task.description.substring(0, 50) + (task.description.length > 50 ? '...' : '') : ''}</div>
            </div>
            <div class="kanban-card-footer">
                <div class="kanban-card-due-date ${dueDateClass}">
                    <i class="far fa-calendar-alt"></i> ${daysUntilDue}
                </div>
                <div class="kanban-card-assignee">
                    <img src="https://i.pravatar.cc/150?u=${task.assignee}" alt="${assigneeName}" title="${assigneeName}">
                </div>
            </div>
        `;
        
        // Add drag and drop functionality
        card.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', task.id);
            card.classList.add('dragging');
            draggedTask = task;
        });
        
        card.addEventListener('dragend', () => {
            card.classList.remove('dragging');
            draggedTask = null;
        });
        
        // Add click handler to open task details
        card.addEventListener('click', () => {
            openTaskDetails(task.id);
        });
        
        return card;
    }
    
