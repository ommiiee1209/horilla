    /**
     * Filter bulletin posts
     */
    function filterBulletinPosts() {
      const filterValue = document.getElementById('bulletin-filter').value;
      const searchValue = document.getElementById('bulletin-search').value.toLowerCase();
      
      let filteredPosts = [...bulletinData];
      
      // Apply filter
      if (filterValue && filterValue !== 'all') {
        filteredPosts = filteredPosts.filter(post => post.category === filterValue);
      }
      
      // Apply search
      if (searchValue) {
        filteredPosts = filteredPosts.filter(post => 
          post.title.toLowerCase().includes(searchValue) || 
          post.content.toLowerCase().includes(searchValue)
        );
      }
      
      // Update UI
      renderBulletinPosts(filteredPosts);
    }
    
