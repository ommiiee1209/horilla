    /**
     * Delete task
     * @param {string} taskId - ID of the task to delete
     */
    function deleteTask(taskId) {
        if (!confirm('このタスクを削除してもよろしいですか？')) return;
        
        const taskIndex = taskData.findIndex(t => t.id === taskId);
        if (taskIndex === -1) return;
        
        const task = taskData[taskIndex];
        
        // Remove from data
        taskData.splice(taskIndex, 1);
        
        // Remove from UI
        const listItem = document.querySelector(`.tasks-table tr[data-task-id="${taskId}"]`);
        if (listItem) {
            listItem.remove();
        }
        
        const kanbanCard = document.querySelector(`.kanban-card[data-task-id="${taskId}"]`);
        if (kanbanCard) {
            kanbanCard.remove();
            updateKanbanCounts();
        }
        
        // Update calendar view
        renderCalendar(calendarCurrentYear, calendarCurrentMonth);
        
        // Update counters and charts
        updateTaskCounters();
        updateCharts();
        
        // Show success message
        showToast('success', 'タスク削除完了', 'タスクが正常に削除されました。');
        
        // Log activity
        logActivity('task_deleted', `Deleted task: ${task.title}`);
    }
    
