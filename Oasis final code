                <span class="timeline-user">${activity.user}</span>
                <span class="timeline-time">${time}</span>
              </div>
              <div class="timeline-body">
                ${activity.description}
              </div>
            </div>
          `;
          
          dateGroup.appendChild(activityItem);
        });
        
        timelineContainer.appendChild(dateGroup);
      });
    }
    
