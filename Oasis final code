/**
 * Authentication Functions
 */
function initAuth() {
    console.log('Initializing authentication...');
    
    // Show login form by default
    if (loginForm) {
        document.getElementById('login-form').classList.add('active');
    }

    // Form Switch Events
    if (loginLink) {
        loginLink.addEventListener('click', (e) => {
            e.preventDefault();
            showAuthForm('login-form');
        });
    }

    if (registerLink) {
        registerLink.addEventListener('click', (e) => {
            e.preventDefault();
            showAuthForm('register-form');
        });
    }

    if (forgotPasswordLink) {
        forgotPasswordLink.addEventListener('click', (e) => {
            e.preventDefault();
            showAuthForm('reset-form');
            showResetStep('reset-step-1');
        });
    }

    if (backToLoginLink) {
        backToLoginLink.addEventListener('click', (e) => {
            e.preventDefault();
            showAuthForm('login-form');
        });
    }

    // Form Submissions
    if (loginForm) {
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('login-email').value;
            const password = document.getElementById('login-password').value;
            
            // Simulate login validation
            if (email && password) {
                // In a real app, you would validate credentials with the server
                simulateLoading(1000, () => {
                    currentUser = {
                        id: 'usr-123',
                        name: email.split('@'),
                        email: email,
                        role: 'Project Manager',
                        avatar: 'https://i.pravatar.cc/150?u=' + email
                    };
                    
                    // Update UI with user info
                    updateUserInfo(currentUser);
                    
                    // Switch to app view
                    authContainer.classList.remove('active');
                    appContainer.classList.add('active');
                    
                    // Load initial data
                    loadDashboardData();
                });
            } else {
                showToast('error', 'ログインエラー', 'メールアドレスとパスワードを入力してください。');
            }
        });
    }

    if (registerForm) {
        registerForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('register-name').value;
            const email = document.getElementById('register-email').value;
            const password = document.getElementById('register-password').value;
            const confirmPassword = document.getElementById('register-confirm-password').value;
            
            // Validate form
            if (!name || !email || !password || !confirmPassword) {
                showToast('error', '登録エラー', 'すべてのフィールドを入力してください。');
                return;
            }
            
            if (password !== confirmPassword) {
                showToast('error', '登録エラー', 'パスワードが一致しません。');
                return;
            }
            
            // Simulate registration
            simulateLoading(1500, () => {
                showAuthForm('login-form');
                showToast('success', 'アカウント作成完了', 'アカウントが正常に作成されました。ログインしてください。');
                
                // Pre-fill login form with the registered email
                document.getElementById('login-email').value = email;
            });
        });
    }

    if (resetForm) {
        resetForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const currentStep = resetForm.querySelector('.reset-step.active');
            
            if (currentStep.id === 'reset-step-1') {
                const email = document.getElementById('reset-email').value;
                if (!email) {
                    showToast('error', 'エラー', 'メールアドレスを入力してください。');
                    return;
                }
                
                simulateLoading(1000, () => {
                    showResetStep('reset-step-2');
                    showToast('info', '確認コード送信完了', email + ' に確認コードを送信しました。');
                });
            } else if (currentStep.id === 'reset-step-2') {
                const codes = Array.from(document.querySelectorAll('.verification-code input')).map(input => input.value);
                if (codes.some(code => !code)) {
                    showToast('error', 'エラー', '確認コードを入力してください。');
                    return;
                }
                
                simulateLoading(1000, () => {
                    showResetStep('reset-step-3');
                });
            } else if (currentStep.id === 'reset-step-3') {
                const newPassword = document.getElementById('new-password').value;
                const confirmPassword = document.getElementById('confirm-password').value;
                
                if (!newPassword || !confirmPassword) {
                    showToast('error', 'エラー', '新しいパスワードを入力してください。');
                    return;
                }
                
                if (newPassword !== confirmPassword) {
                    showToast('error', 'エラー', 'パスワードが一致しません。');
                    return;
                }
                
                simulateLoading(1000, () => {
                    showAuthForm('login-form');
                    showToast('success', 'パスワードリセット完了', 'パスワードが正常にリセットされました。新しいパスワードでログインしてください。');
                });
            }
        });
    }

    // Verification code input handling
    const codeInputs = document.querySelectorAll('.verification-code input');
    if (codeInputs.length > 0) {
        codeInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1) {
                    if (index < codeInputs.length - 1) {
                        codeInputs[index + 1].focus();
                    }
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value === '') {
                    if (index > 0) {
                        codeInputs[index - 1].focus();
                    }
                }
            });
        });
    }

    // Resend code functionality
    const resendCodeBtn = document.querySelector('.resend-code button');
    if (resendCodeBtn) {
        resendCodeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const countdownText = document.querySelector('.resend-code span');
            resendCodeBtn.disabled = true;
            
            let countdown = 60;
            countdownText.textContent = `(${countdown}秒)`;
            
            const timer = setInterval(() => {
                countdown--;
                countdownText.textContent = `(${countdown}秒)`;
                
                if (countdown <= 0) {
                    clearInterval(timer);
                    resendCodeBtn.disabled = false;
                    countdownText.textContent = '';
                }
            }, 1000);
            
            showToast('info', '確認コード再送信', '確認コードを再送信しました。');
        });
    }
}

function showAuthForm(formId) {
