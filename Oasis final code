        if (!groupedActivities[date]) {
          groupedActivities[date] = [];
        }
        groupedActivities[date].push(activity);
      });
      
      // Create timeline
      Object.keys(groupedActivities).forEach(date => {
        const dateGroup = document.createElement('div');
