              const endDate = document.getElementById('edit-project-end-date').value;
              const manager = document.getElementById('edit-project-manager').value;
              const members = Array.from(document.getElementById('edit-project-members').selectedOptions).map(option => option.value);
              
              // Update project data
              projectData[projectIndex] = {
                ...projectData[projectIndex],
                name,
                description,
                status,
                progress,
                startDate,
                endDate,
                manager,
                members: [manager, ...members.filter(m => m !== manager)],
                updatedAt: new Date()
              };
              
              // Update UI
              renderProjects();
              updateProjectSelector();
              
              // If this is the current project, update project details
              if (currentProject && currentProject.id === projectId) {
                currentProject = projectData[projectIndex];
                viewProject(projectId);
              }
              
              // Close modal
              closeModal(document.getElementById('edit-project-modal'));
              
