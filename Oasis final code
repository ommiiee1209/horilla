     * @param {string} postId - ID of the post
     */
    function togglePinPost(postId) {
      const postIndex = bulletinData.findIndex(p => p.id === postId);
      if (postIndex === -1) return;
      
      // Toggle pin status
      bulletinData[postIndex].pinned = !bulletinData[postIndex].pinned;
      
      // Update UI
      renderBulletinPosts();
      
