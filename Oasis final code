               if (dueDateCell) {
                   dueDateCell.textContent = task.dueDate ? formatDate(task.dueDate) : '';
               }
           }
           
           // Update task in kanban view
           let kanbanCard = document.querySelector(`.kanban-card[data-task-id="${task.id}"]`);
           
           // If the status changed, we need to move the card
           if (kanbanCard && !kanbanCard.closest(`.kanban-column[data-status="${task.status}"]`)) {
               // Remove from current column
               kanbanCard.remove();
               kanbanCard = null;
           }
           
           if (!kanbanCard) {
               // Create new kanban card
               const targetColumn = document.querySelector(`.kanban-column[data-status="${task.status}"] .kanban-column-content`);
               if (targetColumn) {
                   kanbanCard = createKanbanCard(task);
                   targetColumn.appendChild(kanbanCard);
                   updateKanbanCounts();
               }
           } else {
               // Update existing card
               kanbanCard.querySelector('.kanban-card-title').textContent = task.title;
               
               const priorityIndicator = kanbanCard.querySelector('.priority-indicator');
               if (priorityIndicator) {
                   priorityIndicator.className = `priority-indicator priority-${task.priority}`;
               }
               
               // Remove all priority classes
               kanbanCard.classList.remove('priority-high', 'priority-medium', 'priority-low');
               kanbanCard.classList.add(`priority-${task.priority}`);
               
