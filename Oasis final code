function initKanban() {
    const kanbanCards = document.querySelectorAll('.kanban-card');
    
    if (kanbanColumns && kanbanColumns.length > 0) {
        // Enable drag and drop for kanban cards
        kanbanCards.forEach(card => {
            card.setAttribute('draggable', true);
            
            card.addEventListener('dragstart', (e) => {
                card.classList.add('dragging');
                draggedTask = card;
                e.dataTransfer.setData('text/plain', card.getAttribute('data-task-id'));
            });
            
            card.addEventListener('dragend', () => {
                card.classList.remove('dragging');
                updateKanbanCounts();
                draggedTask = null;
            });
            
            // Add click event to open task details
            card.addEventListener('click', (e) => {
                // Don't open details if clicking on menu toggle
                if (!e.target.closest('.task-menu-toggle')) {
                    const taskId = card.getAttribute('data-task-id');
                    if (taskId) {
                        openTaskDetails(taskId);
                    }
                }
            });
        });
        
        kanbanColumns.forEach(column => {
            column.addEventListener('dragover', (e) => {
                e.preventDefault();
                const afterElement = getDragAfterElement(column, e.clientY);
                
                if (draggedTask) {
                    if (afterElement) {
                        column.insertBefore(draggedTask, afterElement);
                    } else {
                        column.appendChild(draggedTask);
                    }
                }
            });
            
            column.addEventListener('drop', (e) => {
                e.preventDefault();
                const taskId = e.dataTransfer.getData('text/plain');
                const statusColumn = column.closest('.kanban-column');
                const newStatus = statusColumn.getAttribute('data-status');
                
                if (taskId && newStatus) {
                    updateTaskStatus(taskId, newStatus);
                }
            });
        });
        
        // Initialize context menus for kanban cards
        const taskMenuToggles = document.querySelectorAll('.task-menu-toggle');
        
        taskMenuToggles.forEach(toggle => {
            toggle.addEventListener('click', (e) => {
                e.stopPropagation();
                const taskId = toggle.closest('.kanban-card').getAttribute('data-task-id');
                showTaskContextMenu(toggle, taskId);
            });
        });
        
        // Update initial counts
        updateKanbanCounts();
    }
}

function getDragAfterElement(container, y) {
    const draggableElements = [...container.querySelectorAll('.kanban-card:not(.dragging)')];
    
    return draggableElements.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        
        if (offset < 0 && offset > closest.offset) {
            return { offset, element: child };
        } else {
            return closest;
        }
    }, { offset: Number.NEGATIVE_INFINITY }).element;
}

function updateKanbanCounts() {
    document.querySelectorAll('.kanban-column').forEach(column => {
        const count = column.querySelectorAll('.kanban-card').length;
        const countElement = column.querySelector('.task-count');
        
        if (countElement) {
            countElement.textContent = count;
        }
    });
}

function showTaskContextMenu(element, taskId) {
    // Remove any existing context menus
    document.querySelectorAll('.context-menu').forEach(menu => menu.remove());
    
    // Create context menu
    const contextMenu = document.createElement('div');
    contextMenu.classList.add('context-menu');
    
    contextMenu.innerHTML = `
        <ul>
            <li data-action="edit">編集</li>
            <li data-action="delete">削除</li>
            <li data-action="assign">担当者変更</li>
            <li data-action="priority">優先度変更</li>
        </ul>
    `;
    
    document.body.appendChild(contextMenu);
    
    // Position the menu
    const rect = element.getBoundingClientRect();
    contextMenu.style.top = `${rect.bottom + window.scrollY}px`;
    contextMenu.style.left = `${rect.left + window.scrollX}px`;
    
    // Add event listeners
    contextMenu.querySelectorAll('li').forEach(item => {
        item.addEventListener('click', () => {
            const action = item.getAttribute('data-action');
            handleTaskAction(action, taskId);
            contextMenu.remove();
        });
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', function closeMenu(e) {
        if (!contextMenu.contains(e.target) && !element.contains(e.target)) {
            contextMenu.remove();
            document.removeEventListener('click', closeMenu);
        }
    });
}

function handleTaskAction(action, taskId) {
    switch (action) {
        case 'edit':
            openTaskDetails(taskId);
            break;
        case 'delete':
            confirmDeleteTask(taskId);
            break;
        case 'assign':
            showAssignTaskDialog(taskId);
            break;
        case 'priority':
            showChangePriorityDialog(taskId);
            break;
    }
}

function updateTaskStatus(taskId, newStatus) {
    // In a real app, this would update the task status in the database
    console.log(`Updating task ${taskId} status to ${newStatus}`);
    
    // Find the task in our data
    const task = taskData.find(t => t.id === taskId);
    if (task) {
        task.status = newStatus;
        showToast('success', 'タスク更新', 'タスクのステータスが更新されました。');
    }
}

function confirmDeleteTask(taskId) {
    // Create a confirmation dialog
    const confirmDialog = document.createElement('div');
    confirmDialog.classList.add('modal');
    confirmDialog.classList.add('active');
    
    confirmDialog.innerHTML = `
        <div class="modal-content">
            <div class="modal-header">
                <h2>タスク削除の確認</h2>
                <button class="close-modal">&times;</button>
            </div>
            <div class="modal-body">
                <p>このタスクを削除してもよろしいですか？この操作は元に戻せません。</p>
                <div class="form-actions">
                    <button class="btn btn-secondary cancel-btn">キャンセル</button>
                    <button class="btn btn-danger confirm-btn">削除</button>
                </div>
            </div>
        </div>
    `;
    
    document.body.appendChild(confirmDialog);
    
    // Add event listeners
    confirmDialog.querySelector('.close-modal').addEventListener('click', () => {
        confirmDialog.remove();
    });
    
    confirmDialog.querySelector('.cancel-btn').addEventListener('click', () => {
        confirmDialog.remove();
    });
    
    confirmDialog.querySelector('.confirm-btn').addEventListener('click', () => {
               // Delete the task
               deleteTask(taskId);
               confirmDialog.remove();
           });
       }
       
       function deleteTask(taskId) {
           // Remove the task from DOM
           const taskElements = document.querySelectorAll(`[data-task-id="${taskId}"]`);
           taskElements.forEach(element => element.remove());
           
           // Remove from data array
           taskData = taskData.filter(task => task.id !== taskId);
           
           // Update kanban counts
           updateKanbanCounts();
           
           showToast('success', 'タスク削除完了', 'タスクが削除されました。');
       }
       
       function showAssignTaskDialog(taskId) {
           // Create assign task dialog
           const assignDialog = document.createElement('div');
           assignDialog.classList.add('modal');
           assignDialog.classList.add('active');
           
