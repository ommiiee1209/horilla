          let activityClass = '';
          
          switch (activity.type) {
            case 'task_created':
              icon = '<i class="fas fa-plus-circle"></i>';
              activityClass = 'activity-create';
              break;
            case 'task_updated':
              icon = '<i class="fas fa-edit"></i>';
              activityClass = 'activity-update';
              break;
            case 'task_deleted':
              icon = '<i class="fas fa-trash"></i>';
              activityClass = 'activity-delete';
              break;
            case 'comment_added':
              icon = '<i class="fas fa-comment"></i>';
              activityClass = 'activity-comment';
              break;
            case 'project_created':
              icon = '<i class="fas fa-folder-plus"></i>';
              activityClass = 'activity-create';
              break;
            case 'project_updated':
              icon = '<i class="fas fa-folder-open"></i>';
              activityClass = 'activity-update';
              break;
            case 'project_deleted':
              icon = '<i class="fas fa-folder-minus"></i>';
              activityClass = 'activity-delete';
              break;
            case 'member_added':
              icon = '<i class="fas fa-user-plus"></i>';
              activityClass = 'activity-create';
              break;
            case 'member_updated':
              icon = '<i class="fas fa-user-edit"></i>';
              activityClass = 'activity-update';
              break;
            case 'member_removed':
              icon = '<i class="fas fa-user-minus"></i>';
              activityClass = 'activity-delete';
              break;
            default:
              icon = '<i class="fas fa-info-circle"></i>';
              activityClass = 'activity-info';
          }
          
          // Format time
          const time = new Date(activity.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          
          activityItem.innerHTML = `
            <div class="timeline-icon ${activityClass}">
              ${icon}
