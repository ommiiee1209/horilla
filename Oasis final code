    /**
     * Navigate to a page
     * @param {string} pageId - ID of the target page
     */
    function navigateTo(pageId) {
      if (pages) {
        pages.forEach(page => {
          page.classList.remove('active');
        });
        
        const targetPage = document.getElementById(pageId);
        if (targetPage) {
          targetPage.classList.add('active');
          
          // Update active navigation item
          navItems.forEach(item => {
            if (item.getAttribute('data-target') === pageId) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
          
          // Update page title
          const pageTitle = document.querySelector('.page-title');
          if (pageTitle) {
            pageTitle.textContent = targetPage.getAttribute('data-title') || '';
          }
          
          // Special handling for certain pages
          if (pageId === 'dashboard') {
            updateCharts();
          } else if (pageId === 'tasks') {
            // Reset current project
            currentProject = null;
            
            // Refresh task views
            renderTaskList(taskData);
            renderKanbanBoard(taskData);
            renderCalendar(calendarCurrentYear, calendarCurrentMonth, taskData);
          }
        }
      }
    }
    
    /**
