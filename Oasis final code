               }
               
               const dueDateElement = kanbanCard.querySelector('.due-date');
               if (dueDateElement) {
                   dueDateElement.textContent = task.dueDate ? formatDate(task.dueDate) : '';
               }
           }
           
           // Update task in calendar view (re-render the calendar)
           renderCalendar(calendarCurrentYear, calendarCurrentMonth);
       }
       
       function createKanbanCard(task) {
           const card = document.createElement('div');
           card.classList.add('kanban-card', `priority-${task.priority}`);
           card.setAttribute('data-task-id', task.id);
           card.setAttribute('draggable', true);
           
           const assigneeName = document.querySelector(`#task-assignee option[value="${task.assignee}"]`)?.textContent || 'Unassigned';
           
           card.innerHTML = `
               <div class="priority-indicator priority-${task.priority}"></div>
               <h4 class="kanban-card-title">${task.title}</h4>
               <div class="kanban-card-meta">
                   <div class="assignee">
                       <img src="https://i.pravatar.cc/150?u=${task.assignee}" alt="${assigneeName}" title="${assigneeName}">
                   </div>
                   <div class="due-date">${task.dueDate ? formatDate(task.dueDate) : ''}</div>
                   <div class="task-menu-toggle">⋮</div>
               </div>
           `;
           
           // Add event listeners
           card.addEventListener('dragstart', (e) => {
               card.classList.add('dragging');
               draggedTask = card;
               e.dataTransfer.setData('text/plain', card.getAttribute('data-task-id'));
           });
           
           card.addEventListener('dragend', () => {
               card.classList.remove('dragging');
               updateKanbanCounts();
               draggedTask = null;
           });
           
           card.addEventListener('click', (e) => {
               // Don't open details if clicking on menu toggle
               if (!e.target.closest('.task-menu-toggle')) {
                   openTaskDetails(task.id);
               }
           });
           
           const menuToggle = card.querySelector('.task-menu-toggle');
           if (menuToggle) {
               menuToggle.addEventListener('click', (e) => {
                   e.stopPropagation();
                   showTaskContextMenu(menuToggle, task.id);
               });
           }
           
           return card;
       }
       
       function getStatusText(status) {
           switch (status) {
               case 'todo': return '未着手';
               case 'in-progress': return '進行中';
               case 'review': return 'レビュー';
               case 'done': return '完了';
               default: return status;
           }
       }
       
       function getPriorityText(priority) {
           switch (priority) {
               case 'high': return '高';
               case 'medium': return '中';
               case 'low': return '低';
               default: return priority;
           }
       }
       
       function formatDate(date) {
           if (!(date instanceof Date)) {
               date = new Date(date);
           }
           
           const year = date.getFullYear();
           const month = String(date.getMonth() + 1).padStart(2, '0');
           const day = String(date.getDate()).padStart(2, '0');
           
           return `${year}/${month}/${day}`;
       }
       
