                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        } else {
            // Update existing chart
            chartInstances.taskCompletionTrend.data.labels = dates;
            chartInstances.taskCompletionTrend.data.datasets.data = completedCounts;
            chartInstances.taskCompletionTrend.data.datasets.data = createdCounts;
