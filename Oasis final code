    /**
     * Delete post
     * @param {string} postId - ID of the post to delete
     */
    function deletePost(postId) {
      const post = bulletinData.find(p => p.id === postId);
      if (!post) return;
      
      // Check if current user is the author
      if (post.authorId !== currentUser.id) {
        showToast('error', 'Permission Denied', 'You can only delete your own posts');
        return;
      }
      
      if (!confirm('Are you sure you want to delete this post?')) return;
      
      const postIndex = bulletinData.findIndex(p => p.id === postId);
      if (postIndex === -1) return;
      
      // Remove from data
      bulletinData.splice(postIndex, 1);
      
      // Update UI
      renderBulletinPosts();
      
      // Show success message
      showToast('success', 'Post Deleted', 'Bulletin post has been deleted successfully');
    }
    
    /**
